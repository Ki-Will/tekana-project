# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/tekana
DB_NAME=tekana
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# SMS/USSD Gateway (example)
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_GATEWAY_URL=https://api.sms-gateway.com/send

# Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Application
NODE_ENV=development
PORT=3086

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key-here

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=tekana.events
RABBITMQ_EXCHANGE_TYPE=topic

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_DEFAULT_TTL=3600
REDIS_MAX_RETRIES=3

# AWS S3 (using MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=tekana-media

# Email
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
